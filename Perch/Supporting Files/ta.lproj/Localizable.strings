"welcome_message" = "Perch உங்கள் மெனு பாரில் ஒரு சிஸ்டம் கண்காணிப்பான், ஒரு ஆப்ஸ் துவக்கி, ஒரு சாளர மாற்றி ஆகியவற்றை வைக்கிறது. இந்தச் சிறிய அமைவு முதலில் எதைக் காட்ட வேண்டும் என்பதைத் தேர்ந்தெடுக்கிறது.";
"Select preset" = "முன்னமைவைத் தேர்ந்தெடு";
"select_preset_message" = "தொடங்குவதற்கான தொகுதிகளின் தொகுப்பைத் தேர்ந்தெடுக்கவும். இவற்றில் எதையும் பின்னர் அமைப்புகளில் மாற்றலாம்.";
"Start the application automatically when starting your Mac" = "உங்கள் Mac தொடங்கும்போது பயன்பாட்டைத் தானாகத் தொடங்கு";
"Do not start the application automatically when starting your Mac" = "உங்கள் Mac தொடங்கும்போது பயன்பாட்டைத் தானாகத் தொடங்காதே";
"Do everything silently in the background (recommended)" = "அனைத்தையும் பின்னணியில் அமைதியாகச் செய் (பரிந்துரைக்கப்படுகிறது)";
"Check for a new version on startup" = "தொடக்கத்தில் புதிய பதிப்பைச் சரிபார்";
"Check for a new version every day (once a day)" = "ஒவ்வொரு நாளும் புதிய பதிப்பைச் சரிபார் (நாளுக்கு ஒருமுறை)";
"Check for a new version every week (once a week)" = "ஒவ்வொரு வாரமும் புதிய பதிப்பைச் சரிபார் (வாரத்திற்கு ஒருமுறை)";
"Check for a new version every month (once a month)" = "ஒவ்வொரு மாதமும் புதிய பதிப்பைச் சரிபார் (மாதத்திற்கு ஒருமுறை)";
"Never check for updates (not recommended)" = "புதுப்பிப்புகளை ஒருபோதும் சரிபார்க்காதே (பரிந்துரைக்கப்படவில்லை)";
"The configuration is completed" = "அமைவு முடிந்தது";
"finish_setup_message" = "எல்லாம் தயார்.\n\nPerch இலவசமானது, திறந்த மூலமானது. இது உங்களுக்குப் பயனுள்ளதாக இருந்தால், இதன் மேம்பாட்டை ஆதரிக்கலாம்.";
